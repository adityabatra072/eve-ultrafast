# A RunAnywhere key. Leave it empty to use the key `wally account login` saved.
RUNANYWHERE_API_KEY=
EVE_MODEL=eve
# TYPE_TEXT helper. Any OpenAI-compatible endpoint; defaults to DeepSeek V4.1 Flash on Wally with the same key.
TEXT_MODEL=deepseek-v4.1-flash
# TEXT_MODEL_BASE_URL=https://inference.runanywhere.ai/v1
# TEXT_MODEL_API_KEY=
# Optional. Without these the agent starts its own Chrome on port 9333.
# BU_CDP_URL=http://127.0.0.1:9222
# EVE_HEADLESS=1
